# Core Backend Configuration
JWT_SECRET=dummy_jwt_secret
MONGODB_URI=mongodb+srv://<username>:<password>@mantrasetu-cluster.ejrg9na.mongodb.net/mantrasetu?appName=mantrasetu-cluster
DATABASE_NAME=mantrasetu
API_BASE_URL=http://localhost:8000
MAIN_BACKEND_URL=http://localhost:8000


# LLM Configuration (Gemini)
GEMINI_API_KEY=your_api_key

# STT Configuration (Whisper/Groq)
OPENAI_API_KEY=your_api_key
DEFAULT_STT_PROVIDER=groq

# TTS Configuration (ElevenLabs/InWorld)
ELEVENLABS_API_KEY=your_api_key
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
DEFAULT_TTS_PROVIDER=inworld

# LLM Provider Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=your_api_key
# Primary model — used for intent detection only (200k TPD limit)
GROQ_LLM_MODEL=openai/gpt-oss-120b
# Fast fallback model — used for field extraction (openai/gpt-oss-20b on Groq)
GROQ_LLM_MODEL_FAST=openai/gpt-oss-120b

# InWorld AI Configuration (STT + TTS)
INWORLD_API_KEY=your_api_key
INWORLD_STT_MODEL=inworld/inworld-stt-1
INWORLD_TTS_MODEL=inworld-tts-2-flash
INWORLD_VOICE_ID=Manoj
INWORLD_SPEED=0.88
# Voice Service (Authentication)
VOICE_TICKET_SECRET=change-me-to-a-long-random-value  # REQUIRED -- generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# RAG Configuration
CHROMA_DB_PATH=./data/chroma_db
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
