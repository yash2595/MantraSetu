# Core Backend & Routing
API_BASE_URL=http://localhost:8000
MAIN_BACKEND_URL=http://localhost:8000

# Security & Database
JWT_SECRET=dummy_jwt_secret
JWT_SECRET_KEY=dummy_jwt_secret
VOICE_TICKET_SECRET=mantrasetu_voice_ticket_secret_shared_2026
MONGODB_URI=mongodb+srv://<username>:<password>@mantrasetu-cluster.ejrg9na.mongodb.net/mantrasetu?appName=mantrasetu-cluster
DATABASE_NAME=mantrasetu

# LLM Configuration (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# STT & TTS Configuration (InWorld AI Sole Provider)
DEFAULT_STT_PROVIDER=inworld
DEFAULT_TTS_PROVIDER=inworld

# LLM Provider Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_LLM_MODEL=qwen/qwen3.8-27b
GROQ_LLM_MODEL_FAST=openai/gpt-oss-20b

# InWorld AI Configuration (STT + TTS)
INWORLD_API_KEY=your_inworld_api_key_here
INWORLD_STT_MODEL=inworld/inworld-stt-1
INWORLD_TTS_MODEL=inworld-tts-2-flash
INWORLD_VOICE_ID=Manoj
INWORLD_SPEED=0.88

# RAG Configuration
CHROMA_DB_PATH=./data/chroma_db
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2

# Voice Session Rate Limiting (Dev overrides; production defaults are 5 sessions / 600s)
VOICE_GUEST_SESSION_LIMIT=100
VOICE_GUEST_WINDOW_SECONDS=600